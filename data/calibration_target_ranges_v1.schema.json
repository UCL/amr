{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Calibration target plausible-range registry v1",
  "description": "Row contract for data/calibration_target_ranges_v1.csv. Bounds are display-only and do not enter the calibration score.",
  "type": "object",
  "required": [
    "target_set_version",
    "target_family",
    "target_key",
    "target_label",
    "target_year",
    "central_value",
    "plausible_lower",
    "plausible_upper",
    "unit",
    "interval_kind",
    "provenance_class",
    "source_id",
    "range_method",
    "rationale",
    "last_reviewed"
  ],
  "properties": {
    "target_set_version": {
      "const": "calibration-target-ranges-v1"
    },
    "target_family": {
      "enum": [
        "headline",
        "drug_class_share",
        "infection_incidence",
        "carriage",
        "infection_deaths"
      ]
    },
    "target_key": {
      "type": "string",
      "minLength": 1
    },
    "target_label": {
      "type": "string",
      "minLength": 1
    },
    "target_year": {
      "type": "integer",
      "const": 2025
    },
    "central_value": {
      "type": "number",
      "minimum": 0
    },
    "plausible_lower": {
      "type": "number",
      "minimum": 0
    },
    "plausible_upper": {
      "type": "number",
      "minimum": 0
    },
    "unit": {
      "enum": [
        "millions",
        "percent",
        "proportion"
      ]
    },
    "interval_kind": {
      "enum": [
        "published_uncertainty_range",
        "derived_plausible_range",
        "expert_plausible_range",
        "design_constraint"
      ]
    },
    "provenance_class": {
      "enum": [
        "published_source_range",
        "source_informed_transformed",
        "expert_best_guess_placeholder",
        "structural_design"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_url_or_doi": {
      "type": "string"
    },
    "range_method": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}

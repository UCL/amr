    "world_population": 8200000000
  },
  "calibration_score": {
    "cap": 4.0,
    "report_top_contributors": 8,
    "weights": {
      "headline": 0.20,
      "drug_usage": 0.25,
      "resistance": 0.45,
      "burden": 0.05,
      "resistance_locus": 0.05
    },
    "thresholds": {
      "strong": 1.0,
      "usable": 1.5
    },
    "gates": {
      "people_on_antibiotics_millions": {
        "relative_tolerance": 0.25
      },
      "infection_deaths_millions": {
        "relative_tolerance": 0.25
      },
      "resistance_weighted_abs_delta_pp": {
        "max": 15.0
      },
      "infection_resistance_distance_percentile": {
        "percentile": 99.0,
        "max": 4.0
      }
    },
    "headline": {
      "relative_tolerance": 0.15,
      "minimum_absolute_scale": 0.1,
      "metric_overrides": {
        "infection_deaths_millions": {
          "relative_tolerance": 0.20,
          "minimum_absolute_scale": 0.25
        },
        "people_on_antibiotics_millions": {
          "relative_tolerance": 0.15,
          "minimum_absolute_scale": 2.0
        },
        "annual_infection_incidence_percent": {
          "absolute_tolerance": 3.0
        },
        "sepsis_incident_cases_millions": {
          "relative_tolerance": 0.20,
          "minimum_absolute_scale": 1.0
        }
      }
    },
    "drug_usage": {
      "absolute_tolerance_pp": 3.0
    },
    "resistance": {
      "component_weights": {
        "infection": 4.0,
        "average": 1.0
      },
      "tolerances_pp": {
        "infection": 10.0,
        "average": 10.0
      }
    },
    "burden": {
      "relative_tolerance": 0.50,
      "minimum_absolute_scales": {
        "infection": 0.05,
        "carriage": 0.05,
        "deaths": 0.01
      }
    }
  },
  "headline_metrics": [
    {
      "key": "infection_deaths_millions",
      "label": "Infection deaths (millions)",
      "unit": "millions",
      "target": 6.4,
      "rationale": "Model-scope bacterial infection deaths exclude H. pylori and MDR-TB to match the simulation numerator. This 6.4M target is the rounded sum of per-organism annual death targets after those two exclusions; it sits below the 7.7M GBD/33-pathogen central estimate and avoids calibrating the model to out-of-scope gastric-cancer and tuberculosis mortality."
    },
    {
      "key": "people_on_antibiotics_millions",
      "label": "People on antibiotics on an average day (millions)",
      "unit": "millions",
      "target": 100.0,
      "rationale": "Model-calibrated prevalence proxy revised down from the earlier DDD-based 130M benchmark. Klein et al. reports consumption rather than unique daily users; a 100M daily-user target is a more defensible person-prevalence approximation after allowing for dose intensity, stock-sales mismatch, and non-human/wastage leakage."
    },
    {
      "key": "annual_infection_incidence_percent",
      "label": "Incidence of bacterial infection per year (%)",
      "unit": "percent",
      "target": 15.0
    },
    {
      "key": "sepsis_incident_cases_millions",
      "label": "Incident cases of sepsis (millions)",
      "unit": "millions",
      "target": 30.0,
      "rationale": "Revised from 35M to 30M because Rudd et al. reports all-cause sepsis, whereas the model is bacteria-only. A 30M target preserves a large global sepsis burden while allowing for the substantial viral, fungal, and parasitic share outside model scope."
    }
  ],
  "microbiome_resistance": {
    "label": "Population with resistant microbiome (%)",
    "unit": "percent"
  },
  "bacteria_burden_targets": {
    "infection_incidence_path": "data/infection_incidence_by_bacteria.csv",

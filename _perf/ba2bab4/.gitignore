# Rust build artifacts
/target/
/.rustc_info.json

# Python environments and bytecode
__pycache__/
*.py[cod]
.venv/
venv/

# Local editor and OS noise
.DS_Store
Thumbs.db

# Local diagnostics and crash-hunt scratch files
/_diagnostics/
/MODEL_FAILURE_TRACKER.md
/STACK_OVERFLOW_CRASH_HUNT_PLAN.md
/submit_jump.ps1
